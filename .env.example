APP_NAME=简易图床系统
APP_ENV=development
DEBUG=false
API_PREFIX=/api

SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 本机无 MySQL 时可临时使用：sqlite:///./runtime/image-system.db
DATABASE_URL_OVERRIDE=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=image_system
MYSQL_USER=image_system
MYSQL_PASSWORD=replace-with-database-password

REDIS_URL=redis://127.0.0.1:6379/0
TASK_ALWAYS_EAGER=false
IMAGE_ROOT=/data/image-system
MAX_UPLOAD_SIZE_MB=30

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-admin-password
BOOTSTRAP_ADMIN_EMPLOYEE_ID=ADMIN
