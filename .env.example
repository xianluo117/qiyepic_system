# Docker Compose 应用镜像
APP_IMAGE=qingmiaoai/qiyeimagesystem:latest
WEB_PORT=1230

APP_NAME=简易图床系统
APP_ENV=production
DEBUG=false
API_PREFIX=/api

# 至少 32 个字符，必须替换
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480

MYSQL_DATABASE=image_system
MYSQL_USER=image_system
MYSQL_PASSWORD=replace-with-database-password
MYSQL_ROOT_PASSWORD=replace-with-root-database-password

# Linux 服务器可改为绝对路径，例如 /data/image-system
IMAGE_DATA_PATH=./data/images
MAX_UPLOAD_SIZE_MB=30

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-character-password
BOOTSTRAP_ADMIN_EMPLOYEE_ID=ADMIN

API_WORKERS=2
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO
