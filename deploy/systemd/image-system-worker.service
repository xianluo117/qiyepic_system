[Unit]
Description=Image System Celery Worker
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service

[Service]
Type=simple
User=image-system
Group=image-system
WorkingDirectory=/opt/image-system/backend
EnvironmentFile=/opt/image-system/config/backend.env
ExecStart=/opt/image-system/venv/bin/celery -A worker.celery_app:celery_app worker --loglevel=INFO --concurrency=2
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
